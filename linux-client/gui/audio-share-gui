#!/usr/bin/python3
"""Audio Share — minimal GTK3 client window for the Linux `as-client`.

Runs `as-client -v` as a child process and mirrors its log lines into the
window, so the same binary does the protocol work and the GUI stays thin.
Settings live in ~/.config/audio-share-client/config.json, shared with the
`audio-share-client-run` wrapper used by the systemd user unit.

No GTK4/libadwaita dependency on purpose: GTK3 is what Phosh/older ARM
distros ship by default.
"""

import json
import os
import re
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

APP_ID = "audio-share-client"
AS_CLIENT = os.environ.get("AUDIO_SHARE_CLIENT_BIN", "/usr/bin/as-client")
SERVICE = "audio-share-client.service"
CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), APP_ID)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")

DEFAULTS = {
    "host": "192.168.7.9",
    "port": 65530,
    "target": "",
    "latency": "",
    "autostart": False,
}

RE_FORMAT = re.compile(r"format: encoding=(\S+?)\((\d+)\) channels=(\d+) rate=(\d+)")
RE_BYTES = re.compile(r"received (\d+) bytes of PCM")
RE_SESSION = re.compile(r"play session id=(-?\d+)")


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh))
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
    os.replace(tmp, CONFIG_PATH)


def human_rate(bps):
    if bps >= 1024 * 1024:
        return "%.1f MB/s" % (bps / 1024 / 1024)
    return "%.0f KB/s" % (bps / 1024)


def service_active():
    try:
        out = subprocess.run(
            ["systemctl", "--user", "is-active", SERVICE],
            capture_output=True, text=True, timeout=3,
        )
        return out.stdout.strip() == "active"
    except Exception:
        return False


def service_enabled():
    try:
        out = subprocess.run(
            ["systemctl", "--user", "is-enabled", SERVICE],
            capture_output=True, text=True, timeout=3,
        )
        return out.stdout.strip() == "enabled"
    except Exception:
        return False


def systemctl(*args):
    try:
        return subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=10,
        )
    except Exception as exc:  # pragma: no cover - defensive
        return subprocess.CompletedProcess(args, 1, "", str(exc))


def list_sinks():
    try:
        out = subprocess.run(["pactl", "list", "short", "sinks"],
                             capture_output=True, text=True, timeout=3)
    except Exception:
        return []
    sinks = []
    for line in out.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            sinks.append((parts[0], parts[1]))
    return sinks


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="Audio Share")
        self.set_border_width(14)
        self.set_default_size(420, -1)
        self.set_icon_name(APP_ID)

        self.cfg = load_config()
        self.proc = None
        self.pid = None
        self.io_id = None
        self.watch_id = None
        self.buf = b""
        self.last_bytes = None
        self.last_bytes_t = None
        self.rate = 0.0
        self.reconnect_timer = None  # unused placeholder for clarity

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        title = Gtk.Label()
        title.set_markup("<b><span size='large'>Audio Share</span></b>\n"
                         "<small>把电脑的声音放到这台设备上播放</small>")
        title.set_xalign(0)
        outer.pack_start(title, False, False, 0)

        grid = Gtk.Grid(row_spacing=8, column_spacing=8)
        grid.set_column_homogeneous(False)

        grid.attach(self._label("服务器地址"), 0, 0, 1, 1)
        self.host_entry = Gtk.Entry()
        self.host_entry.set_text(str(self.cfg.get("host", "")))
        self.host_entry.set_hexpand(True)
        self.host_entry.set_placeholder_text("192.168.1.10")
        grid.attach(self.host_entry, 1, 0, 2, 1)

        grid.attach(self._label("端口"), 0, 1, 1, 1)
        adj = Gtk.Adjustment(value=int(self.cfg.get("port", 65530)),
                             lower=1, upper=65535, step_increment=1)
        self.port_spin = Gtk.SpinButton(adjustment=adj, climb_rate=1, digits=0)
        self.port_spin.set_hexpand(False)
        grid.attach(self.port_spin, 1, 1, 2, 1)

        grid.attach(self._label("输出设备"), 0, 2, 1, 1)
        self.sink_combo = Gtk.ComboBoxText()
        self.sink_combo.append("", "系统默认")
        for idx, name in list_sinks():
            self.sink_combo.append(name, "%s (#%s)" % (name, idx))
        self.sink_combo.set_active_id(str(self.cfg.get("target", "")) or "")
        if self.sink_combo.get_active_id() is None:
            self.sink_combo.set_active_id("")
        self.sink_combo.set_hexpand(True)
        grid.attach(self.sink_combo, 1, 2, 2, 1)

        outer.pack_start(grid, False, False, 0)

        self.action_btn = Gtk.Button()
        self.action_btn.get_style_context().add_class("suggested-action")
        self.action_btn.connect("clicked", self.on_action)
        outer.pack_start(self.action_btn, False, False, 0)

        self.status = Gtk.Label(label="未连接")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        outer.pack_start(self.status, False, False, 0)

        self.rate_label = Gtk.Label(label="")
        self.rate_label.set_xalign(0)
        ctx = self.rate_label.get_style_context()
        ctx.add_class("dim-label")
        outer.pack_start(self.rate_label, False, False, 0)

        self.hint = Gtk.Label(label="")
        self.hint.set_xalign(0)
        self.hint.set_line_wrap(True)
        self.hint.get_style_context().add_class("dim-label")
        outer.pack_start(self.hint, False, False, 0)

        outer.pack_start(Gtk.Separator(), False, False, 4)

        self.autostart = Gtk.CheckButton(label="开机自动连接（后台服务）")
        self.autostart.set_active(bool(self.cfg.get("autostart", False)))
        self.autostart.connect("toggled", self.on_autostart)
        outer.pack_start(self.autostart, False, False, 0)

        self.add(outer)
        self.connect("destroy", self.on_destroy)

        self.refresh_ui()
        GLib.timeout_add_seconds(4, self.poll_service_state)

    # ---------- helpers ----------
    @staticmethod
    def _label(text):
        lbl = Gtk.Label(label=text)
        lbl.set_xalign(0)
        return lbl

    def settings(self):
        target = self.sink_combo.get_active_id() or ""
        return {
            "host": self.host_entry.get_text().strip(),
            "port": int(self.port_spin.get_value()),
            "target": target,
            "latency": str(self.cfg.get("latency", "")),
            "autostart": self.autostart.get_active(),
        }

    def refresh_ui(self):
        if self.proc is not None:
            self.action_btn.set_label("停止播放")
            self.action_btn.get_style_context().remove_class("suggested-action")
            self.action_btn.get_style_context().add_class("destructive-action")
            self.host_entry.set_sensitive(False)
            self.port_spin.set_sensitive(False)
            self.sink_combo.set_sensitive(False)
            return

        self.action_btn.get_style_context().remove_class("destructive-action")
        self.action_btn.get_style_context().add_class("suggested-action")
        if service_active():
            self.action_btn.set_label("停止后台播放")
            self.status.set_text("后台服务正在播放（由开机自启启动）")
            self.host_entry.set_sensitive(False)
            self.port_spin.set_sensitive(False)
            self.sink_combo.set_sensitive(False)
        else:
            self.action_btn.set_label("开始播放")
            self.host_entry.set_sensitive(True)
            self.port_spin.set_sensitive(True)
            self.sink_combo.set_sensitive(True)
            if not self.status.get_text().startswith("服务器"):
                self.status.set_text("未连接")

    def poll_service_state(self):
        if self.proc is None:
            self.refresh_ui()
        return True

    # ---------- actions ----------
    def on_action(self, _btn):
        if self.proc is not None:
            self.stop_client()
            return
        if service_active():
            res = systemctl("stop", SERVICE)
            if res.returncode != 0:
                self.hint.set_text("停止后台服务失败：%s" % (res.stderr.strip() or "未知错误"))
            else:
                self.hint.set_text("已停止后台服务")
            self.refresh_ui()
            return
        self.start_client()

    def start_client(self):
        cfg = self.settings()
        save_config(cfg)
        if not cfg["host"]:
            self.status.set_text("请先填服务器地址")
            return
        if not os.access(AS_CLIENT, os.X_OK):
            self.status.set_text("找不到 %s（请安装 audio-share-client 包）" % AS_CLIENT)
            return

        argv = [AS_CLIENT, cfg["host"], str(cfg["port"]), "-v"]
        if cfg["target"]:
            argv += ["--target", cfg["target"]]
        if cfg["latency"]:
            argv += ["--latency", cfg["latency"]]

        try:
            proc = subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.PIPE, bufsize=0)
        except OSError as exc:
            self.status.set_text("启动失败：%s" % exc)
            return

        self.proc = proc
        self.pid = proc.pid
        self.buf = b""
        self.last_bytes = None
        self.last_bytes_t = None
        self.rate = 0.0
        self.status.set_text("连接 %s:%s …" % (cfg["host"], cfg["port"]))
        self.rate_label.set_text("")
        self.hint.set_text("")
        fd = proc.stderr.fileno()
        self.io_id = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP, self.on_log)
        self.watch_id = GLib.child_watch_add(GLib.PRIORITY_DEFAULT, self.pid,
                                             self.on_child_exit)
        self.refresh_ui()

    def stop_client(self):
        if self.proc is None:
            return
        try:
            self.proc.send_signal(signal.SIGTERM)
        except OSError:
            pass
        self.status.set_text("已停止")
        self.rate_label.set_text("")

    def on_child_exit(self, pid, status):
        self.watch_id = None
        if self.io_id is not None:
            GLib.source_remove(self.io_id)
            self.io_id = None
        try:
            if self.proc and self.proc.stderr:
                self.proc.stderr.close()
        except OSError:
            pass
        self.proc = None
        self.pid = None
        self.refresh_ui()

    def on_log(self, fd, condition):
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        if not chunk:
            self.io_id = None
            return False
        self.buf += chunk
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            self.handle_line(line.decode("utf-8", "replace"))
        return True

    def handle_line(self, line):
        if line.startswith("[as-client] "):
            line = line[len("[as-client] "):]
        else:
            return

        m = RE_FORMAT.search(line)
        if m:
            self.status.set_text("已连接・%s・%sch・%s Hz"
                                 % (m.group(1), m.group(3), m.group(4)))
            return

        m = RE_BYTES.search(line)
        if m:
            total = int(m.group(1))
            now = GLib.get_monotonic_time() / 1e6
            if self.last_bytes is not None and now > self.last_bytes_t:
                self.rate = (total - self.last_bytes) / (now - self.last_bytes_t)
                self.rate_label.set_text("接收 %s（原始 PCM，未压缩）"
                                         % human_rate(self.rate))
            self.last_bytes = total
            self.last_bytes_t = now
            return

        if RE_SESSION.search(line):
            return

        if ("bad AudioFormat size" in line
                or "cannot connect TCP" in line
                or "heartbeat timeout" in line):
            hint = ""
            if "bad AudioFormat size" in line:
                hint = "（电脑端没有可用音频输出，检查 as-cmd -l 后重启 as-cmd）"
            self.status.set_text("未连上／已断开，正在重试 %s" % hint)
            self.rate_label.set_text("")
            self.last_bytes = None
            return

        if "cannot spawn pw-cat" in line:
            self.status.set_text("播放器起不来：缺少 pipewire-bin 的 pw-cat")
            return

    # ---------- autostart ----------
    def on_autostart(self, btn):
        cfg = self.settings()
        save_config(cfg)
        systemctl("daemon-reload")
        if btn.get_active():
            res = systemctl("enable", "--now", SERVICE)
            if res.returncode != 0:
                self.hint.set_text("开启自启失败：%s"
                                   % (res.stderr.strip().splitlines()[-1] if res.stderr.strip() else "未知错误"))
                btn.set_active(False)
                return
            self.hint.set_text("已开启开机自动连接（下次启动自动播放）")
        else:
            systemctl("disable", "--now", SERVICE)
            self.hint.set_text("已关闭开机自动连接")
        self.refresh_ui()

    # ---------- shutdown ----------
    def on_destroy(self, _w):
        if self.proc is not None:
            try:
                self.proc.send_signal(signal.SIGTERM)
            except OSError:
                pass
        save_config(self.settings())
        Gtk.main_quit()


def main():
    win = Window()
    win.show_all()
    if service_active():
        win.status.set_text("后台服务正在播放（由开机自启启动）")
        win.refresh_ui()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
